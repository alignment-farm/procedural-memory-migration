    "schema": "CREATE TABLE accounts_503(id INTEGER PRIMARY KEY, active INTEGER); CREATE TABLE charges_503(id INTEGER PRIMARY KEY, account_id INTEGER, amount INTEGER, settled INTEGER); CREATE TABLE refunds_503(id INTEGER PRIMARY KEY, account_id INTEGER, amount INTEGER, approved INTEGER);",
    "ask": "Return one row for EVERY active account: id, net. Net is total settled charges minus total approved refunds, treating missing totals as zero. Include negative and zero net accounts. Multiple charges and refunds can belong to the same account. Order by id.",
    "threshold": 25,
    "cutoff": 5
  },
