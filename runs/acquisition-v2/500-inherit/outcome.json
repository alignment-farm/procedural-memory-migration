    "schema": "CREATE TABLE accounts_500(id INTEGER PRIMARY KEY, active INTEGER); CREATE TABLE charges_500(id INTEGER PRIMARY KEY, account_id INTEGER, amount INTEGER, settled INTEGER); CREATE TABLE refunds_500(id INTEGER PRIMARY KEY, account_id INTEGER, amount INTEGER, approved INTEGER);",
    "ask": "Return one row for EVERY active account: id, net. Net is total settled charges minus total approved refunds, treating missing totals as zero. Include negative and zero net accounts. Multiple charges and refunds can belong to the same account. Order by id.",
    "threshold": 44,
    "cutoff": 8
  },
  "model": "docker.io/ai/qwen3.8:27b-q4_K_M",
  "memory": "Use correlated subqueries for independent aggregates to avoid Cartesian product inflation from multiple LEFT JOINs. Structure: SELECT a.id, (SELECT COALESCE(SUM(amount),0) FROM charges WHERE account_id=a.id AND settled=1) - (SELECT COALESCE(SUM(amount),0) FROM refunds WHERE account_id=a.id AND approved=1) AS net FROM accounts WHERE active=1 ORDER BY id. This ensures correct totals when multiple records exist per account. Verify row count matches active accounts if results seem inflated.",
