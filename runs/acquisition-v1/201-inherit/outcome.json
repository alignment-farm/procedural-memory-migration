      "content": "{\"action\":\"submit\",\"sql\":\"SELECT a.id, COALESCE((SELECT e.state FROM events_201 e WHERE e.account_id = a.id AND e.at <= 6 ORDER BY e.at DESC, e.id DESC LIMIT 1), 'NONE') AS state FROM accounts_201 a WHERE a.active = 1 ORDER BY a.id\"}",
