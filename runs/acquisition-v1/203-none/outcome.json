    {
      "content": "{\"action\":\"submit\",\"sql\":\"SELECT a.id, (COALESCE((SELECT SUM(c.amount) FROM charges_203 c WHERE c.account_id = a.id AND c.settled = 1), 0) - COALESCE((SELECT SUM(r.amount) FROM refunds_203 r WHERE r.account_id = a.id AND r.approved = 1), 0)) AS net FROM accounts_203 a WHERE a.active = 1 ORDER BY a.id\"}",
      "finish_reason": "stop"
    }
