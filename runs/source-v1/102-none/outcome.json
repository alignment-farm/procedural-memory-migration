      "content": "{\"action\":\"check\",\"sql\":\"SELECT a.id, COUNT(i.id) AS qualifying_count FROM accounts_102 a JOIN items_102 i ON i.account_id = a.id WHERE a.active = 1 AND NOT EXISTS (SELECT 1 FROM items_102 bad WHERE bad.account_id = a.id AND (bad.status IS NULL OR bad.status <> 'ok')) AND NOT EXISTS (SELECT 1 FROM items_102 amt WHERE amt.account_id = a.id AND (amt.amount IS NULL OR amt.amount < 24)) AND NOT EXISTS (SELECT 1 FROM blocks_102 b WHERE b.account_id = a.id) GROUP BY a.id ORDER BY a.id\"}",
