  "events": [
    {
      "content": "{\"action\":\"submit\",\"sql\":\"SELECT a.id, COALESCE(SUM(CASE WHEN c.settled = 1 THEN c.amount ELSE 0 END), 0) - COALESCE(SUM(CASE WHEN r.approved = 1 THEN r.amount ELSE 0 END), 0) AS net FROM accounts_100 a LEFT JOIN charges_100 c ON a.id = c.account_id LEFT JOIN refunds_100 r ON a.id = r.account_id WHERE a.active = 1 GROUP BY a.id ORDER BY a.id\"}",
      "finish_reason": "stop"
    }
