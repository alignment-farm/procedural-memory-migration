      "content": "{\"action\":\"check\",\"sql\":\"SELECT a.id, COUNT(i.id) AS qualifying_count FROM accounts_105 a JOIN items_105 i ON i.account_id = a.id WHERE a.active = 1 AND NOT EXISTS (SELECT 1 FROM items_105 bad WHERE bad.account_id = a.id AND (bad.status IS NULL OR bad.status <> 'ok')) AND NOT EXISTS (SELECT 1 FROM items_105 badamt WHERE badamt.account_id = a.id AND (badamt.amount IS NULL OR badamt.amount < 52)) AND NOT EXISTS (SELECT 1 FROM blocks_105 b WHERE b.account_id = a.id) GROUP BY a.id ORDER BY a.id\"}",
