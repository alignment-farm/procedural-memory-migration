    {
      "content": "{\"action\":\"submit\",\"sql\":\"SELECT a.id, (SELECT COALESCE(SUM(c.amount),0) FROM charges_103 c WHERE c.account_id=a.id AND c.settled=1) - (SELECT COALESCE(SUM(r.amount),0) FROM refunds_103 r WHERE r.account_id=a.id AND r.approved=1) AS net FROM accounts_103 a WHERE a.active=1 ORDER BY a.id\"}",
